# Public local Supabase API settings: obtain from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Seed script ONLY. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set both explicitly when seeding local demo accounts. Use unique local passwords.
DEMO_ADMIN_PASSWORD=
DEMO_DRIVER_PASSWORD=
# Server-only 32-byte hex key for trusted driver PIN recovery. Keep stable and
# back it up securely; never use a NEXT_PUBLIC_ prefix or rotate without rewrap.
OFFLINE_DEVICE_RECOVERY_KEY=
